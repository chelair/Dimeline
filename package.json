{
  "name": "dimeline",
  "version": "1.1.0",
  "private": true,
  "description": "Dimeline 专业桌面时间线排期工具",
  "author": "Dimeline",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "setup:desktop": "node scripts/setup-electron.mjs",
    "postinstall": "node scripts/setup-electron.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"{src,electron,tests,scripts}/**/*.{ts,tsx,js,mjs,css}\" \"*.{ts,js,json,html,md}\"",
    "format:check": "prettier --check \"{src,electron,tests,scripts}/**/*.{ts,tsx,js,mjs,css}\" \"*.{ts,js,json,html,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "package:win": "npm run build && node scripts/package-windows.mjs",
    "package:dir": "npm run build && node scripts/package-windows.mjs --dir"
  },
  "dependencies": {
    "lucide-react": "0.577.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.2.2",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "app.dimeline.desktop",
    "productName": "Dimeline",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Dimeline-${version}-Setup.${ext}"
    },
    "extraMetadata": {
      "description": "专业桌面时间线排期工具"
    }
  }
}
